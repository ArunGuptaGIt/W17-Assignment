
GEMINI_API_KEY=your_google_gemini_api_key_here


# LLM Provider Models & Endpoints
PRIMARY_MODEL=gemini-3.6-flash
LOCAL_VLLM_MODEL=Qwen/Qwen2.5-1.5B-Instruct-AWQ

# Service Base URLs & Timeouts
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_TIMEOUT=60.0
REDIS_URL=redis://localhost:6379/0


# RAG Models & Hardware Device Configuration
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BACKEND=pytorch  # Options: pytorch | onnx_fp32 | onnx_int8
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cpu


# RAG Pipeline Strategy Defaults
DEFAULT_CHUNKING_STRATEGY=recursive
DEFAULT_RETRIEVAL_MODE=hybrid
ENABLE_RERANKER=true
FUSION_TOP_K=15
FINAL_TOP_K=5
RRF_K=60

# Context & Sampling Parameters
MAX_CONTEXT_TOKENS=2048
MAX_OUTPUT_TOKENS=1024
TEMPERATURE=0.2
TOP_P=0.95
CONFIDENCE_THRESHOLD=0.05
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
